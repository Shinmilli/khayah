generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int      @id @default(autoincrement())
  userLogin        String   @map("user_login") @db.VarChar(60)
  userPass         String   @map("user_pass") @db.VarChar(255)
  userNicename     String   @map("user_nicename") @db.VarChar(50)
  userEmail        String   @map("user_email") @db.VarChar(100)
  userUrl          String   @default("") @map("user_url") @db.VarChar(100)
  userRegistered   DateTime @default(now()) @map("user_registered")
  userActivationKey String  @default("") @map("user_activation_key") @db.VarChar(255)
  userStatus       Int      @default(0) @map("user_status")
  displayName      String   @default("") @map("display_name") @db.VarChar(250)

  posts    Post[]
  comments Comment[]

  @@map("users")
}

model Post {
  id                  Int      @id @default(autoincrement())
  postAuthorId        Int      @map("post_author")
  postDate            DateTime @default(now()) @map("post_date")
  postDateGmt         DateTime @default(now()) @map("post_date_gmt")
  postContent         String   @map("post_content") @db.Text
  postTitle           String   @map("post_title") @db.Text
  postExcerpt         String   @default("") @map("post_excerpt") @db.Text
  postStatus          String   @default("publish") @map("post_status") @db.VarChar(20)
  commentStatus       String   @default("open") @map("comment_status") @db.VarChar(20)
  pingStatus          String   @default("open") @map("ping_status") @db.VarChar(20)
  postPassword        String   @default("") @map("post_password") @db.VarChar(255)
  postName            String   @default("") @map("post_name") @db.VarChar(200)
  postModified        DateTime @default(now()) @map("post_modified")
  postModifiedGmt    DateTime @default(now()) @map("post_modified_gmt")
  postParent          Int      @default(0) @map("post_parent")
  guid                String   @default("") @db.VarChar(255)
  menuOrder           Int      @default(0) @map("menu_order")
  postType            String   @default("post") @map("post_type") @db.VarChar(20)
  postMimeType        String   @default("") @map("post_mime_type") @db.VarChar(100)
  commentCount        Int      @default(0) @map("comment_count")

  author   User         @relation(fields: [postAuthorId], references: [id])
  comments Comment[]
  postMeta PostMeta[]
  termRelationships TermRelationship[]

  @@index([postType, postStatus, postDate])
  @@index([postAuthorId])
  @@map("posts")
}

model Comment {
  id               Int      @id @default(autoincrement())
  postId           Int      @map("comment_post_ID")
  commentAuthor    String   @map("comment_author") @db.Text
  commentAuthorEmail String @default("") @map("comment_author_email") @db.VarChar(100)
  commentAuthorUrl  String  @default("") @map("comment_author_url") @db.VarChar(200)
  commentDate      DateTime @default(now()) @map("comment_date")
  commentDateGmt   DateTime @default(now()) @map("comment_date_gmt")
  commentContent   String   @map("comment_content") @db.Text
  commentKarma     Int      @default(0) @map("comment_karma")
  commentApproved  String   @default("1") @map("comment_approved") @db.VarChar(20)
  commentAgent     String   @default("") @map("comment_agent") @db.VarChar(255)
  commentType      String   @default("") @map("comment_type") @db.VarChar(20)
  commentParent    Int      @default(0) @map("comment_parent")
  userId           Int      @default(0) @map("user_id")

  post    Post         @relation(fields: [postId], references: [id])
  user    User?        @relation(fields: [userId], references: [id])
  commentMeta CommentMeta[]

  @@index([postId])
  @@map("comments")
}

model PostMeta {
  id        Int     @id @default(autoincrement())
  postId    Int     @map("post_id")
  metaKey   String? @map("meta_key") @db.VarChar(255)
  metaValue String? @map("meta_value") @db.Text

  post Post @relation(fields: [postId], references: [id])

  @@index([postId])
  @@map("postmeta")
}

model CommentMeta {
  id        Int     @id @default(autoincrement())
  commentId Int     @map("comment_id")
  metaKey   String? @map("meta_key") @db.VarChar(255)
  metaValue String? @map("meta_value") @db.Text

  comment Comment @relation(fields: [commentId], references: [id])

  @@index([commentId])
  @@map("commentmeta")
}

model Term {
  id        Int      @id @default(autoincrement())
  name      String   @default("") @db.VarChar(200)
  slug      String   @default("") @db.VarChar(200)
  termGroup Int      @default(0) @map("term_group")

  termTaxonomies TermTaxonomy[]

  @@map("terms")
}

model TermTaxonomy {
  id          Int      @id @default(autoincrement())
  termId      Int      @map("term_id")
  taxonomy    String   @default("") @db.VarChar(32)
  description String   @default("") @map("description") @db.Text
  parent      Int      @default(0)
  count       Int      @default(0)

  term         Term               @relation(fields: [termId], references: [id])
  termRelationships TermRelationship[]

  @@unique([termId, taxonomy])
  @@index([taxonomy])
  @@map("term_taxonomy")
}

model TermRelationship {
  objectId        Int @map("object_id")
  termTaxonomyId  Int @map("term_taxonomy_id")
  termOrder       Int @default(0) @map("term_order")

  post         Post         @relation(fields: [objectId], references: [id])
  termTaxonomy TermTaxonomy @relation(fields: [termTaxonomyId], references: [id])

  @@id([objectId, termTaxonomyId])
  @@index([termTaxonomyId])
  @@map("term_relationships")
}

model Inquiry {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(80)
  contact   String    @db.VarChar(120)
  pinHash   String    @map("pin_hash") @db.VarChar(255)
  type      String    @db.VarChar(40)
  subject   String    @db.VarChar(200)
  body      String    @db.Text
  status    String    @default("대기") @db.VarChar(20)
  reply     String    @default("") @db.Text
  memo      String    @default("") @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  repliedAt DateTime? @map("replied_at")

  @@index([name, contact])
  @@index([status, createdAt])
  @@map("inquiries")
}
