# Database — Supabase Session pooler (WSL/Render용 IPv4)
# Connect → Session pooler → URI (port 5432)
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

MOCK_DATA=false
PORT=3001

# CORS — 프론트 실제 URL (배포 시). 쿠키 로그인에 필요하므로 실제 출처를 적으세요.
# CLIENT_ORIGIN=https://your-frontend.example.com
CLIENT_ORIGIN=http://localhost:5173

# Google 관리자 로그인 (OAuth 클라이언트 유형: 웹 애플리케이션)
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보
# 승인된 JavaScript 원본: http://localhost:5173 및 배포 프론트 URL
GOOGLE_CLIENT_ID=
# 세션 쿠키 HMAC 비밀키 (16자 이상). 배포 환경에서는 반드시 설정.
ADMIN_SESSION_SECRET=
# 관리자 테이블이 비어 있을 때, 이 Google 이메일의 첫 로그인이 슈퍼 관리자가 됩니다.
ADMIN_BOOTSTRAP_EMAIL=
# 임시 목업 로그인. Google 연동 후 반드시 false
ADMIN_DEMO_LOGIN=true

# Cloudinary (≤10MB 이미지·PDF)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=khayah

# YouTube RSS (선택 — 기본: @khayahinternational2804)
# YOUTUBE_CHANNEL_ID=UCy-1WbDWu7vm05dStUD0Cxg
# RSS 실패 시 홈 홍보영상 폴백 (선택)
# YOUTUBE_FALLBACK_VIDEO_ID=my_KtM2p4q0
# YOUTUBE_FALLBACK_TITLE=영상 제목
# YOUTUBE_FALLBACK_PUBLISHED_AT=2026-01-01T00:00:00+00:00

# Supabase Storage (>10MB PDF 등)
# Dashboard → Settings → API → Project URL + service_role key
# Storage → New bucket: uploads (Public ON)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
