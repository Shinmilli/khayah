# Database (Render PostgreSQL)
# Format (Render Postgres typical):
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=public"

# Server
PORT=3001

# URLs
# - Used for CORS in `src/index.ts`


# Client origin for CORS (default: http://localhost:5173)
# CLIENT_ORIGIN=http://localhost:5173

# Uploads (local disk; for production prefer object storage)
# UPLOADS_DIR="C:\\path\\to\\uploads"
