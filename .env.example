# Database (Render PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/khayah?schema=public"

# Server
PORT=3001

# Optional: Client origin for CORS (default: http://localhost:5173)
# CLIENT_ORIGIN=http://localhost:5173

# Optional: Client API base (for production build)
# VITE_API_BASE=http://localhost:3001/api
